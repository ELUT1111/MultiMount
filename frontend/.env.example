# 后端 API 地址。留空时走 Vite 代理 /api。
VITE_API_BASE_URL=

# Vite 开发服务 HTTPS 开关。
VITE_DEV_HTTPS=false

# Vite 代理目标。HTTP 后端示例:
VITE_PROXY_TARGET=http://127.0.0.1:8014

# HTTPS 前端开发模式示例:
# VITE_DEV_HTTPS=true
# VITE_PROXY_TARGET=https://localhost:8014
# VITE_HTTPS_CERT=../backend/certs/localhost+3.pem
# VITE_HTTPS_KEY=../backend/certs/localhost+3-key.pem
